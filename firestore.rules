rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
//  ZenDay — Reglas de seguridad de Firestore
// ═══════════════════════════════════════════════════════════════════════════
//
//  POR QUÉ ESTE ARCHIVO ES EL MÁS IMPORTANTE DEL PARCHE
//  ────────────────────────────────────────────────────
//  La apiKey de src/firebase.js está dentro del .exe y eso está bien: en
//  Firebase la apiKey no es un secreto, sólo identifica el proyecto. Lo que
//  decide quién puede leer qué son estas reglas. Son la única frontera entre
//  los datos de un consultorio y los de otro.
//
//  Si el proyecto todavía está en modo de prueba ("allow read, write: if
//  request.time < ...") o en `if request.auth != null`, entonces hoy cualquier
//  persona que se registre en ZenDay puede leer los pedidos, los clientes y la
//  facturación de TODOS los demás negocios. Con datos de pacientes de por medio,
//  eso además es un problema legal, no sólo técnico.
//
//  CÓMO DESPLEGARLAS
//  ─────────────────
//    1. Guardá este archivo como firestore.rules en la raíz del proyecto.
//    2. Probalas primero sin romper nada:
//         Consola de Firebase → Firestore → Reglas → Área de pruebas (Rules Playground)
//    3. Desplegá:
//         npx firebase deploy --only firestore:rules
//       (o pegalas en la consola y "Publicar")
//    4. Verificá con dos cuentas distintas que una no ve los datos de la otra.
//
//  MODELO DE DATOS QUE ASUMEN
//  ──────────────────────────
//    users/{uid}                                      → { email, businessId, isOwner }
//    businesses/{businessId}                          → { createdBy, createdAt, members: [uid], roles? }
//
//  ROLES (opcional, y por eso esto se puede desplegar sin migrar nada)
//  ──────────────────────────────────────────────────────────────────
//    roles: { "<uid>": "dueno" | "profesional" | "asistente" }
//
//      dueno        todo, incluidas finanzas y auditoría
//      profesional  agenda + historias clínicas; NO ve gastos ni auditoría
//      asistente    agenda solamente; NO abre una historia clínica
//
//    Si un negocio NO tiene el campo `roles`, todos sus miembros son dueños.
//    Eso es EXACTAMENTE lo que pasa hoy, así que estas reglas se pueden
//    desplegar sobre los datos que ya existen sin dejar a nadie afuera y sin
//    tocar un solo documento. Los roles se agregan negocio por negocio, cuando
//    hagan falta, sin volver a tocar este archivo.
//
//    Ojo con el caso al revés: si el negocio SÍ declara `roles` y un uid no
//    figura, se le da el rol MÍNIMO (asistente), no el máximo. Sin esa
//    asimetría, cualquiera que se sumara con el código del negocio entraría
//    como dueño.
//    businesses/{businessId}/data/{modo}/{col}/{docId} → pedidos, clientes, productos, gastos
//    config/app                                       → { latestVersion, downloadUrl, releaseNotes }
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ──────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isMemberOf(businessId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/businesses/$(businessId))
        && request.auth.uid in get(/databases/$(database)/documents/businesses/$(businessId)).data.members;
    }

    // ── Roles ───────────────────────────────────────────────────────────
    function rolEn(businessId) {
      let negocio = get(/databases/$(database)/documents/businesses/$(businessId)).data;
      return !('roles' in negocio)
        ? 'dueno'
        : (request.auth.uid in negocio.roles ? negocio.roles[request.auth.uid] : 'asistente');
    }

    // Puede abrir una historia clínica.
    function veHistorias(businessId) {
      // Los parentesis no son decorativos: sin ellos esto se agrupa como
      // (isMemberOf(...) && rolEn(...)) in ['dueno','profesional'], o sea un
      // booleano comparado contra una lista de textos. Eso revienta la
      // evaluacion, y una regla que revienta DENIEGA -- con lo cual el test
      // pasaba igual, pero por el motivo equivocado: no habria denegado por
      // el rol sino por el error, y el dia que el error se arregle solo, la
      // regla deja de proteger nada.
      return isMemberOf(businessId) && (rolEn(businessId) in ['dueno', 'profesional']);
    }

    // Puede ver la plata y la auditoría. La secretaria agenda, no mira la caja.
    function veLaCaja(businessId) {
      return isMemberOf(businessId) && rolEn(businessId) == 'dueno';
    }

    // Claves que cambian entre el documento actual y el propuesto.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ─── PERFIL DE USUARIO ────────────────────────────────────────────────
    // Cada quien lee y escribe solamente su propio documento.
    // Que nadie más pueda leerlo importa: acá vive el businessId, que es la
    // credencial con la que se entra a un negocio.
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(
             ['email', 'businessId', 'isOwner', 'createdAt', 'updatedAt', 'displayName']
           );

      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(
             ['email', 'businessId', 'isOwner', 'createdAt', 'updatedAt', 'displayName']
           );

      // El borrado de cuenta pasa por soporte, no por el cliente.
      allow delete: if false;
    }

    // ─── NEGOCIO ──────────────────────────────────────────────────────────
    match /businesses/{businessId} {

      // Sólo los miembros ven el documento (y por lo tanto la lista de miembros).
      allow get: if isMemberOf(businessId);

      // Nunca se listan negocios: sin esto, un cliente podría enumerar todos
      // los consultorios que usan ZenDay.
      allow list: if false;

      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.keys().hasOnly(['createdBy', 'createdAt', 'members', 'name', 'roles'])
        // Si nace con roles, el que lo crea queda como dueño. Si no, se podría
        // crear un negocio sin nadie con permiso para repartir roles.
        && (!('roles' in request.resource.data)
            || request.resource.data.roles[request.auth.uid] == 'dueno');

      // Un miembro puede editar los datos del negocio, pero NO la lista de
      // miembros ni quién lo creó por esta vía.
      allow update: if isMemberOf(businessId)
        && !changedKeys().hasAny(['members', 'createdBy'])
        // Los roles los reparte el dueño y nadie más. Sin esto, la asistente
        // se asciende sola editando el documento del negocio.
        && (!changedKeys().hasAny(['roles']) || rolEn(businessId) == 'dueno');

      // Sumarse o salirse: sólo con el propio uid, un cambio por vez.
      // Esto es lo que impide que alguien se agregue a un negocio ajeno y,
      // sobre todo, que expulse a los demás miembros de uno propio.
      allow update: if isSignedIn()
        && changedKeys().hasOnly(['members'])
        && (
          // Sumarse: la lista nueva es la vieja + mi uid
          (
            !(request.auth.uid in resource.data.members)
            && request.resource.data.members.hasAll(resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() + 1
            && request.auth.uid in request.resource.data.members
          )
          ||
          // Salirse: la lista nueva es la vieja - mi uid
          (
            request.auth.uid in resource.data.members
            && resource.data.members.hasAll(request.resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() - 1
            && !(request.auth.uid in request.resource.data.members)
          )
        );

      allow delete: if false;

      // ─── DATOS DEL NEGOCIO ──────────────────────────────────────────────
      // pedidos / clientes / productos / gastos, separados por modo
      // (professional | entrepreneur). Ésta es la regla que efectivamente
      // aísla un consultorio de otro.
      // Qué puede tocar cada rol. La regla real está acá abajo, en `puede`:
      //
      //   patients          historias clínicas   → dueño y profesional
      //   expenses, audit   plata y trazabilidad → sólo el dueño
      //   appointments      la agenda            → todos, también la asistente
      //   products          catálogo             → todos
      //
      // La asistente agenda, reprograma y cancela, pero no abre una historia.
      // Ése es el corte que hace que un consultorio con secretaria pueda usar
      // esto sin que ella lea lo que se habló en sesión.
      function puede(businessId, collectionName) {
        return collectionName == 'patients'                ? veHistorias(businessId)
             : collectionName in ['expenses', 'audit']     ? veLaCaja(businessId)
             : isMemberOf(businessId);
      }

      match /data/{mode}/{collectionName}/{docId} {
        allow read: if puede(businessId, collectionName);

        allow create, update: if puede(businessId, collectionName)
          && mode in ['professional', 'entrepreneur']
          && collectionName in ['appointments', 'patients', 'products', 'expenses', 'audit']
          // Techo de tamaño: evita que un bug de sincronización (o alguien con
          // la sesión abierta) infle la facturación de Firestore con un documento
          // gigante. Firestore permite hasta 1 MB; 200 KB sobra para un pedido.
          && request.resource.data.size() < 200;

        allow delete: if puede(businessId, collectionName);
      }

      // Cualquier otra ruta bajo /data queda cerrada por defecto.
      match /data/{document=**} {
        allow read, write: if false;
      }
    }

    // ─── CONFIGURACIÓN PÚBLICA (chequeo de versión) ───────────────────────
    // electron/main.cjs lee este documento por REST y SIN token de sesión,
    // porque corre antes de que el usuario se loguee. Por eso la lectura es
    // pública. La escritura tiene que estar cerrada: acá vive `downloadUrl`,
    // la dirección desde la que los clientes bajan el instalador. Si alguien
    // pudiera escribirla, distribuiría su propio ejecutable a todos tus
    // usuarios. Se edita solamente desde la consola de Firebase.
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ─── CIERRE POR DEFECTO ───────────────────────────────────────────────
    // Todo lo que no esté explícitamente permitido arriba, se deniega.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
