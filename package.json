{
  "name": "zenday",
  "version": "1.0.9",
  "description": "ZenDay - Gestión inteligente para emprendedores",
  "author": "Francisco",
  "main": "electron/main.cjs",
  "type": "commonjs",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "dist": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:zip": "npm run build && electron-builder --win --x64",
    "electron": "electron electron/main.cjs",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron electron/main.cjs\"",
    "build:exe": "npm run build && electron-builder --win",
    "postinstall": "electron-builder install-app-deps",
    "test:rules": "npx --yes firebase-tools emulators:exec --only firestore \"node test/firestore-rules.test.mjs\"",
    "deploy:rules": "npx --yes firebase-tools deploy --only firestore:rules,database",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rtdb": "npx --yes firebase-tools emulators:exec --only database \"node test/rtdb-rules.test.mjs\""
  },
  "build": {
    "appId": "com.zenday.app",
    "productName": "ZenDay",
    "publish": {
      "provider": "github",
      "owner": "FranciscoDRA",
      "repo": "zenday",
      "private": true
    },
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!node_modules/.cache",
      "!dist/**/*.map"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "dist",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ZenDay"
    }
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "electron-updater": "^6.8.3",
    "firebase": "^12.12.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.2/xlsx-0.20.2.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.1",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.1.2",
    "electron": "^36.7.0",
    "electron-builder": "^26.0.12",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "vite": "^6.0.4",
    "vitest": "^4.1.11",
    "wait-on": "^8.0.3"
  }
}
